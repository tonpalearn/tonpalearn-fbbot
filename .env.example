# ── Facebook / Messenger ───────────────────────────────────────────────
# เอาจาก developers.facebook.com → แอปของคุณ
FB_APP_SECRET=                    # ใช้ตรวจลายเซ็น X-Hub-Signature-256
FB_VERIFY_TOKEN=                  # สตริงอะไรก็ได้ที่คุณตั้งเอง ต้องกรอกให้ตรงกันตอนตั้ง webhook
FB_PAGE_ID=                       # ไอดีเพจ TONPALEARN
FB_PAGE_ACCESS_TOKEN=             # โทเคนเพจแบบไม่หมดอายุ (Page Access Token)
# ตรวจเวอร์ชันล่าสุดที่ developers.facebook.com/docs/graph-api/changelog ก่อน deploy
GRAPH_API_VERSION=v21.0

# ── Supabase ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # ใช้เฉพาะฝั่งเซิร์ฟเวอร์ ห้ามหลุดไปฝั่งเบราว์เซอร์

# ── Anthropic (สมองของบอต) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=700

# ── สมองไฮบริด: เกณฑ์ที่จูนได้ ─────────────────────────────────────────
KB_SIMILARITY_THRESHOLD=0.35      # คะแนนความคล้ายขั้นต่ำที่ยอมให้เอา chunk มาตอบ
KB_TOP_K=5                        # จำนวน chunk ที่ดึงมาให้โมเดล
HISTORY_TURNS=8                   # จำนวนข้อความย้อนหลังที่ส่งเป็นบริบท
DAILY_AI_CALL_CAP=500             # เพดานเรียกโมเดลต่อวัน กันค่าใช้จ่ายบานปลาย

# ── หน้าแอดมิน ─────────────────────────────────────────────────────────
ADMIN_PASSCODE=                   # รหัสเข้าหน้าแอดมิน (ตั้งให้ยาว ๆ)
ADMIN_SESSION_SECRET=             # สตริงสุ่มยาว ≥32 ตัว ใช้เซ็นคุกกี้
NEXT_PUBLIC_APP_URL=http://localhost:3000
